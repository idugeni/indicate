# Indicate bootstrap configuration contract - 16 required vars (+ optional),
# mirrored by .env and .env.production.
#
# Copy this file to .env and replace every placeholder with authorized
# values. .env is git-ignored, so real credentials belong there and never
# in this file. Next.js loads .env for application commands; export the
# same values into the process environment when running database tooling
# manually, or supply them from the deployment secret manager.
#
# Non-secret production defaults (hosts, locale, asset URL, gate mode,
# environment) live in code — see src/core/config/bootstrap/bootstrap-schema.ts
# and src/core/config/edge-hosts.ts. Set them here only to override.
#
# Validation fails closed: restart the application after each change.
# In production every secret must be at least 24 characters and must not
# contain changeme, example, placeholder, sentinel, development, or test-secret.
#
# --- SUPABASE (one project provides both PostgreSQL and Auth) ----------------
# SUPABASE_PROJECT_REF is optional; when set, the three URLs below must agree
# with it, or validation rejects them:
#   NEXT_PUBLIC_SUPABASE_URL host  == <ref>.supabase.co
#   DATABASE_POOL_URL username      == indicate_runtime.<ref>
#   DATABASE_DIRECT_URL host        == db.<ref>.supabase.co
# The indicate_runtime role is created by src/data/migrations/20260903000500_security.sql.
NEXT_PUBLIC_SITE_URL=https://indicate.website
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
DATABASE_POOL_URL=postgresql://indicate_runtime.abcdefghijklmnop:replace-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_DIRECT_URL=postgresql://postgres:replace-password@db.abcdefghijklmnop.supabase.co:5432/postgres

# --- CLOUDFLARE (authoritative DNS, CDN, and edge TLS) ------------------------
# Inject and overwrite CLOUDFLARE_ORIGIN_SECRET as a header at Cloudflare, and
# reject requests without it at the origin.
CLOUDFLARE_API_TOKEN=replace-secret
CLOUDFLARE_ORIGIN_SECRET=replace-origin-secret

# --- CLOUDFLARE R2 (one private media bucket) ---------------------------------
# The bucket must stay private. Media access is exact-key and ownership-scoped;
# bucket listing is never granted.
R2_ACCESS_KEY_ID=replace-secret
R2_SECRET_ACCESS_KEY=replace-secret

# OPTIONAL - WORM audit export (bucket R2 terpisah + token scoped).
# Tanpa ini, ekspor audit harian nonaktif (rute menjawab 503) dan tidak ada
# yang gagal saat boot.
# R2_AUDIT_BUCKET_NAME=indicate-audit-worm
# R2_AUDIT_ACCESS_KEY_ID=replace-secret
# R2_AUDIT_SECRET_ACCESS_KEY=replace-secret

# OPTIONAL - Bucket media publik (baca langsung tanpa tanda tangan).
# Wajib sepasang; tanpa ini URL route bertanda tangan tetap otoritatif
# dan tidak ada yang gagal saat boot.
# R2_PUBLIC_BUCKET_NAME=indicate-media-public
# R2_PUBLIC_HOST=media.indicate.website

# --- UPSTASH REDIS (one resource: queue, cache, rate limits) ------------------
# Redis is acceleration only and never durable authority.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-secret

# --- VERCEL (hosting only, exact custom domains only) -------------------------
# Vercel never receives nameserver authority and never registers wildcards.
VERCEL_API_TOKEN=replace-secret

# --- RESEND (transactional email, optional) -------------------------------------
# Tanpa pasangan ini, pengiriman email nonaktif (komposisi mengembalikan null)
# dan boot tetap hijau. Keduanya wajib diisi bersamaan bila dipakai.
# RESEND_API_KEY=replace-secret
# RESEND_DEFAULT_FROM=Indicate <noreply@indicate.website>
# OPTIONAL - penandatangan webhook Resend (Svix, format whsec_...). Tanpa ini
# rute /api/webhooks/resend menjawab 503 dan event pengiriman tak tercatat.
# RESEND_WEBHOOK_SECRET=replace-secret

# --- WEBHOOK SECURITY -------------------------------------------------------
# Freshness and replay windows live in the webhook policy table.
GENERIC_WEBHOOK_SECRET=replace-generic-webhook-secret
CRON_SECRET=replace-secret

# OPTIONAL - FACEBOOK PRE-SCRAPE (server-side only, never commit values) --------
# App token format: APP_ID|APP_SECRET (no expiry). Without this, social warm
# still heats edge/render caches but skips the Facebook scrape API call.
# FB_APP_TOKEN=replace-with-app-id-pipe-app-secret

# OPTIONAL - OBSERVABILITY FLAGS ------------------------------------------------
# Read by src/core/config/runtime/runtime-flags.ts. Leave unset for default behavior.
# OBSERVABILITY_DEBUG=1 enables debug-level structured logs (default: off).
# OBSERVABILITY_DEBUG=

# OPTIONAL - PAGEVIEW BEACON ---------------------------------------------------
# Read by src/core/config/edge-hosts.ts (client). Leave unset to use the
# default Cloudflare Worker endpoint.
# NEXT_PUBLIC_PAGEVIEW_ENDPOINT=https://pv.indicate.website/v

# OPTIONAL - TURNSTILE (bot protection for auth forms) ----------------------------
# Read by src/modules/auth/components/turnstile-field.tsx (client). Leave unset
# to render auth forms without a challenge; set it once Supabase Auth captcha
# is enabled with the matching secret, otherwise sign-in/up/recovery is rejected.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# (end of bootstrap configuration contract)
