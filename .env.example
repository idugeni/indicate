# Indicate runtime configuration contract.
#
# Copy this file to .env.local and replace every placeholder with authorized
# values. .env.local is git-ignored, so real credentials belong there and never
# in this file. Next.js loads .env.local for application commands; export the
# same values into the process environment when running database tooling
# manually, or supply them from the deployment secret manager.
#
# Every variable in the REQUIRED section is validated by the runtime Zod schema.
# Validation fails closed: restart the application after each change.
#
# =============================================================================
# REQUIRED - 1. SUPABASE (one project provides both PostgreSQL and Auth)
# =============================================================================
# SUPABASE_PROJECT_REF must be the project ref, 8-32 chars of [a-z0-9].
# Legacy anon and service_role JWT keys no longer exist on new projects; use the
# publishable and secret keys from Settings -> API Keys.
# The three values below must all agree with the project ref, or validation rejects
# them:
#   NEXT_PUBLIC_SUPABASE_URL host  == <ref>.supabase.co
#   DATABASE_POOL_URL host          ends with .pooler.supabase.com
#   DATABASE_POOL_URL username      == indicate_runtime.<ref>
#   DATABASE_DIRECT_URL host        == db.<ref>.supabase.co
# The indicate_runtime role is created by src/data/migrations/20260903000500_security.sql; set
# its password before using the pooled URL.
SUPABASE_PROJECT_REF=abcdefghijklmnop
# Public site origin used for OAuth and email-confirmation redirect targets.
NEXT_PUBLIC_SITE_URL=https://indicate.web.id
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-secret
DATABASE_POOL_URL=postgresql://indicate_runtime.abcdefghijklmnop:replace-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_DIRECT_URL=postgresql://postgres:replace-password@db.abcdefghijklmnop.supabase.co:5432/postgres

# =============================================================================
# REQUIRED - 2. HOSTS AND ENVIRONMENT
# =============================================================================
# MVP_ROOT_HOSTS must be exactly three distinct hostnames ending in .web.id,
# none of which may equal a control-plane host below.
APP_ENVIRONMENT=development
SCHEMA_GATE_MODE=live
DASHBOARD_HOST=indicate.web.id
API_HOST=api.indicate.web.id
WEBHOOK_HOST=webhook.indicate.web.id
MVP_ROOT_HOSTS=news-one.example.web.id,news-two.example.web.id,news-three.example.web.id

# =============================================================================
# REQUIRED - 3. CLOUDFLARE (authoritative DNS, CDN, and edge TLS)
# =============================================================================
# CLOUDFLARE_ZONE_IDS must be exactly three distinct zone IDs, one per configured
# root host, in the same order. CLOUDFLARE_EXPECTED_NAMESERVERS accepts 2-5
# entries. CLOUDFLARE_SSL_MODE accepts only full_strict.
# Inject and overwrite CLOUDFLARE_ORIGIN_SECRET as a header at Cloudflare, and
# reject requests without it at the origin.
CLOUDFLARE_ACCOUNT_ID=replace-account-id
CLOUDFLARE_API_TOKEN=replace-secret
CLOUDFLARE_ORIGIN_SECRET=replace-origin-secret
CLOUDFLARE_ZONE_IDS=zone-one,zone-two,zone-three
CLOUDFLARE_EXPECTED_NAMESERVERS=ns1.cloudflare.example,ns2.cloudflare.example
CLOUDFLARE_SSL_MODE=full_strict

# =============================================================================
# REQUIRED - 4. CLOUDFLARE R2 (one private media bucket)
# =============================================================================
# The bucket must stay private. Media access is exact-key and ownership-scoped;
# bucket listing is never granted.
R2_ACCOUNT_ID=replace-account-id
R2_BUCKET_NAME=indicate-media
R2_ACCESS_KEY_ID=replace-secret
R2_SECRET_ACCESS_KEY=replace-secret
MEDIA_MAX_BYTES=10485760
MEDIA_UPLOAD_TTL_SECONDS=600
MEDIA_READ_TTL_SECONDS=300
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif

# =============================================================================
# REQUIRED - 5. UPSTASH REDIS (one resource: queue, cache, rate limits)
# =============================================================================
# Redis is acceleration only and never durable authority.
# REDIS_NAMESPACE must match indicate:<environment>:v<number>.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-secret
UPSTASH_REDIS_RESOURCE_ID=replace-resource-id
REDIS_NAMESPACE=indicate:development:v1

# =============================================================================
# REQUIRED - 6. VERCEL (hosting only, exact custom domains only)
# =============================================================================
# Vercel never receives nameserver authority and never registers wildcards.
VERCEL_PROJECT_ID=replace-project-id
VERCEL_TEAM_ID=replace-team-id
VERCEL_API_TOKEN=replace-secret
VERCEL_PRODUCTION_TARGET=cname.vercel-dns.com

# =============================================================================
# REQUIRED - 7. TELEGRAM AND WEBHOOK SECURITY
# =============================================================================
# WEBHOOK_REPLAY_TTL_SECONDS must be greater than or equal to
# WEBHOOK_FRESHNESS_SECONDS. In production every secret here must be at least 24
# characters and must not contain changeme, example, placeholder, sentinel,
# development, or test-secret.
TELEGRAM_BOT_TOKEN=replace-secret
TELEGRAM_WEBHOOK_SECRET=replace-secret
TELEGRAM_WEBHOOK_URL=https://webhook.indicate.web.id/telegram
GENERIC_WEBHOOK_SECRET=replace-generic-webhook-secret
WEBHOOK_FRESHNESS_SECONDS=300
WEBHOOK_REPLAY_TTL_SECONDS=900
CRON_SECRET=replace-secret
REDACTION_POLICY_VERSION=v1

# =============================================================================
# REQUIRED - 8. PUBLICATION, CACHE, SEO, AND RATE POLICY
# =============================================================================
# PUBLISH_RETRY_DELAYS_SECONDS may hold at most PUBLISH_MAX_ATTEMPTS - 1 entries.
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_RETRY_DELAYS_SECONDS=5,30,120,300
PUBLISH_LEASE_SECONDS=30
PUBLISH_BATCH_SIZE=10
PUBLISH_FUNCTION_DEADLINE_SECONDS=50
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_VERSION=v1
DEFAULT_LOCALE=id-ID
SITE_FALLBACK_ASSET_URL=https://indicate.web.id/assets/site-fallback.png
RATE_LIMIT_MUTATION_ALLOWANCE=30
RATE_LIMIT_MUTATION_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_ALLOWANCE=60
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_READ_ALLOWANCE=300
RATE_LIMIT_PUBLIC_READ_WINDOW_SECONDS=60

# =============================================================================
# OPTIONAL - OBSERVABILITY FLAGS
# =============================================================================
# Read by src/core/config/runtime/runtime-flags.ts. Leave unset for default behavior.
# OBSERVABILITY_DEBUG=1 enables debug-level structured logs (default: off).
# OBSERVABILITY_DEBUG=

# (end of runtime configuration contract)
