# Indicate bootstrap configuration contract - 16 required vars (+ optional),
# mirrored by .env and .env.production.
#
# Copy this file to .env and replace every placeholder with authorized
# values. .env is git-ignored, so real credentials belong there and never
# in this file. Next.js loads .env for application commands; export the
# same values into the process environment when running database tooling
# manually, or supply them from the deployment secret manager.
#
# Non-secret production defaults (hosts, locale, asset URL, gate mode,
# environment) live in code — see src/core/config/bootstrap/bootstrap-schema.ts
# and src/core/config/edge-hosts.ts. Set them here only to override.
#
# Validation fails closed: restart the application after each change.
# In production every secret must be at least 24 characters and must not
# contain changeme, example, placeholder, sentinel, development, or test-secret.
#
# --- NEON (PostgreSQL + Managed Better Auth) --------------------------------
# Use Neon production branch connection strings. Pool URL uses Neon pooler;
# direct URL is reserved for migrations and administrative tooling.
DATABASE_POOL_URL=postgresql://indicate_runtime:replace-password@ep-example-pooler.c-4.ap-southeast-1.aws.neon.tech/indicate?sslmode=require
DATABASE_DIRECT_URL=postgresql://indicate_runtime:replace-password@ep-example.c-4.ap-southeast-1.aws.neon.tech/indicate?sslmode=require
NEON_AUTH_BASE_URL=https://your-neon-auth-host/indicate/auth
# Generate with: openssl rand -base64 32. Server-only; never use NEXT_PUBLIC_.
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# --- CLOUDFLARE (authoritative DNS, CDN, and edge TLS) ------------------------
# Inject and overwrite CLOUDFLARE_ORIGIN_SECRET as a header at Cloudflare, and
# reject requests without it at the origin.
CLOUDFLARE_API_TOKEN=replace-secret
CLOUDFLARE_ORIGIN_SECRET=replace-origin-secret

# OPTIONAL - CLOUDFLARE AI GATEWAY (cache + observability untuk trafik Gemini) --
# Buat gateway di dashboard Cloudflare (AI > AI Gateway), lalu isi slug-nya.
# Tanpa ini, adapter Gemini tetap direct dan boot tetap hijau. Saat diisi,
# request Gemini lewat gateway dengan header cache `cf-aig-cache-ttl`
# (default 86400 detik, minimal 60, maksimal 2592000) sehingga prompt redaksi
# yang berulang tidak memakan kuota Gemini. Auth tetap memakai kunci provider
# dari `ai_credentials` (BYOK); tidak ada key baru di sini.
# CLOUDFLARE_AI_GATEWAY_SLUG=indicate-redaksi
# CLOUDFLARE_AI_GATEWAY_CACHE_TTL_SECONDS=86400

# OPTIONAL - WORKERS AI EMBEDDING (reindex + semantic-search hemat kuota) -----
# Model embedding Workers AI yang dipakai sebelum fallback ke Gemini
# (default `@cf/baai/bge-base-en-v1.5`, dari alokasi gratis 10000 Neurons/hari).
# Tanpa override, reindex memakai default lalu jatuh ke Gemini bila habis.
# CLOUDFLARE_AI_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# --- CLOUDFLARE R2 (one private media bucket) ---------------------------------
# The bucket must stay private. Media access is exact-key and ownership-scoped;
# bucket listing is never granted.
R2_ACCESS_KEY_ID=replace-secret
R2_SECRET_ACCESS_KEY=replace-secret

# OPTIONAL - WORM audit export (bucket R2 terpisah + token scoped).
# Tanpa ini, ekspor audit harian nonaktif (rute menjawab 503) dan tidak ada
# yang gagal saat boot.
# R2_AUDIT_BUCKET_NAME=indicate-audit-worm
# R2_AUDIT_ACCESS_KEY_ID=replace-secret
# R2_AUDIT_SECRET_ACCESS_KEY=replace-secret

# OPTIONAL - Bucket media publik (baca langsung tanpa tanda tangan).
# Wajib sepasang; tanpa ini URL route bertanda tangan tetap otoritatif
# dan tidak ada yang gagal saat boot.
# R2_PUBLIC_BUCKET_NAME=indicate-media-public
# R2_PUBLIC_HOST=media.indicate.website

# --- UPSTASH REDIS (one resource: queue, cache, rate limits) ------------------
# Redis is acceleration only and never durable authority.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-secret

# OPTIONAL - NEON SNAPSHOT STORE ----------------------------------------------
# Only set this when runtime snapshots use a separately provisioned Neon database.
# The primary application database is DATABASE_POOL_URL / DATABASE_DIRECT_URL.
# NEON_SNAPSHOT_DATABASE_URL=postgresql://user:replace-password@ep-example-pooler.c-4.ap-southeast-1.aws.neon.tech/indicate?sslmode=require

# --- VERCEL (hosting only, exact custom domains only) -------------------------
# Vercel never receives nameserver authority and never registers wildcards.
VERCEL_API_TOKEN=replace-secret

# OPTIONAL - Vercel Spend Management webhook signing secret. Tanpa ini rute
# /api/webhooks/vercel-spend menjawab 503 dan boot tetap hijau. Isi dengan
# "Webhook secret" dari `vercel budgets set --amount <usd> --webhook
# https://webhook.indicate.website/api/webhooks/vercel-spend`, lalu set juga
# sebagai env production di dashboard Vercel.
# VERCEL_SPEND_WEBHOOK_SECRET=replace-secret

# OPTIONAL - Vercel deployment webhook signing secret. Tanpa ini rute
# /api/webhooks/vercel-deploy menjawab 503 dan boot tetap hijau. Isi dengan
# secret dari `vercel webhooks create
# https://webhook.indicate.website/api/webhooks/vercel-deploy -e
# deployment.error -e deployment.canceled -p <project-id>`, lalu set juga
# sebagai env production di dashboard Vercel.
# VERCEL_DEPLOY_WEBHOOK_SECRET=replace-secret

# --- RESEND (transactional email, optional) -------------------------------------
# Tanpa pasangan ini, pengiriman email nonaktif (komposisi mengembalikan null)
# dan boot tetap hijau. Keduanya wajib diisi bersamaan bila dipakai.
# RESEND_API_KEY=replace-secret
# RESEND_DEFAULT_FROM=Indicate <noreply@indicate.website>
# OPTIONAL - penandatangan webhook Resend (Svix, format whsec_...). Tanpa ini
# rute /api/webhooks/resend menjawab 503 dan event pengiriman tak tercatat.
# RESEND_WEBHOOK_SECRET=replace-secret

# --- WEBHOOK SECURITY -------------------------------------------------------
# Freshness and replay windows live in the webhook policy table.
GENERIC_WEBHOOK_SECRET=replace-generic-webhook-secret
CRON_SECRET=replace-secret

# OPTIONAL - GOOGLE SEARCH CONSOLE (meta-tag verification, dashboard host only) --
# Ambil token di Search Console > Verifikasi kepemilikan > Tag HTML, lalu isi
# hanya kodenya (tanpa <meta>). Contoh: GOOGLE_SITE_VERIFICATION=dBw...xYz
# Tanpa ini, meta google-site-verification tidak dirender dan boot tetap hijau.
# GOOGLE_SITE_VERIFICATION=replace-with-google-site-verification

# OPTIONAL - INDEXNOW (instant push ke Bing/Yandex/Naver, semua tenant) --------
# Generate sekali (8-128 char, [A-Za-z0-9-]), contoh: openssl rand -hex 32.
# Tanpa ini, file kunci tidak diserve dan submit IndexNow nonaktif,
# boot tetap hijau. Saat diisi, tiap host menyerve /{key}.txt berisi key
# dan worker penerbitan mengirim URL published ke api.indexnow.org.
# INDEXNOW_KEY=replace-with-indexnow-key

# OPTIONAL - GOOGLE OAUTH CREDENTIALS (operator tooling only) -------------------
# These credentials are for Google owner tooling and are not an app login provider.
# Tanpa ketiganya, boot tetap hijau.
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-secret
# GOOGLE_REFRESH_TOKEN=replace-secret
#
# Path absolut ke file OAuth client JSON milik mesin ini saja, dibaca MCP
# Search Console dari process environment. Tidak pernah ditulis di .mcp.json
# atau opencode.jsonc karena path itu tidak portabel.
# GSC_OAUTH_CLIENT_SECRETS_FILE=replace-with-absolute-path-to-client-secret-json

# OPTIONAL - OBSERVABILITY FLAGS ------------------------------------------------
# Read by src/core/config/runtime/runtime-flags.ts. Leave unset for default behavior.
# OBSERVABILITY_DEBUG=1 enables debug-level structured logs (default: off).
# OBSERVABILITY_DEBUG=

# OPTIONAL - PAGEVIEW BEACON ---------------------------------------------------
# Read by src/core/config/edge-hosts.ts (client). Leave unset to use the
# default Cloudflare Worker endpoint.
# NEXT_PUBLIC_PAGEVIEW_ENDPOINT=https://pv.indicate.website/v

# OPTIONAL - TURNSTILE (bot protection for auth + report forms) -------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is read by src/components/turnstile-challenge.tsx
# (client) and renders the widget in auth forms. Leave unset to render those
# forms without a challenge. Server-side Siteverify must be enabled for auth endpoints;
# the Neon Auth route must validate signup, signin, and recovery requests before forwarding them.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
# TURNSTILE_AUTH_SECRET=replace-with-turnstile-secret-key
#
# NEXT_PUBLIC_DISQUS_SHORTNAME is read by src/core/config/disqus-forum.ts
# (client) and is the ONE Disqus forum serving every tenant in the network, so a
# single value covers hundreds of portals. It is public by design: it is
# interpolated into https://<shortname>.disqus.com/embed.js on reader pages, so
# boot rejects anything that is not a plain DNS label (lowercase alphanumerics
# and interior hyphens). Leave it unset to ship no comment surface at all; every
# site also needs site_settings.comments_enabled, which defaults to false.
# Disqus matches the forum to a page by domain, so register each apex and
# subdomain that should host a thread under this one forum in the Disqus
# dashboard. Threads are keyed by shortname plus identifier, and the identifier
# is namespaced per site, so one article syndicated to several portals keeps a
# separate discussion on each.
# NEXT_PUBLIC_DISQUS_SHORTNAME=replace-with-disqus-shortname
#
# TURNSTILE_REPORT_SECRETS is server-only and holds the Siteverify secret of
# every tenant report widget, as a JSON object keyed by site key. Cloudflare
# authorizes at most ten hostnames per widget, so a network of hundreds of apexes
# needs several widgets, and a token verifies only under the secret of the widget
# that issued it. `domains.report_challenge_sitekey` names the widget for each
# apex; a tenant whose widget has no entry here runs unchallenged under the
# per-host and per-IP rate limits. Boot fails on malformed JSON, a key that is
# not a site key, or a placeholder value.
# TURNSTILE_REPORT_SECRETS={"0x0000000000000000000AA":"replace-with-turnstile-secret-key"}

# (end of bootstrap configuration contract)
