{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "ignoreCommand": "sh scripts/ci/skip-build.sh",
  "crons": [
    {
      "path": "/api/internal/maintenance/view-flush",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/internal/publishing?mode=work",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/delivery/reconcile?scope=provisioning",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/delivery/reconcile?scope=invalidation",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/maintenance/cert-renewal",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/internal/maintenance/worm-export",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/internal/maintenance/media-reconcile",
      "schedule": "12 6 * * *"
    },
    {
      "path": "/api/internal/maintenance/status-probe",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/health",
      "schedule": "47 4 * * *"
    }
  ]
}