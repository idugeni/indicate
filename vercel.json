{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!*.md' ':!docs/**' ':!.github/**' ':!.agents/**' ':!.claude/**' && git diff --quiet HEAD^ HEAD -- public/",
  "crons": [
    {
      "path": "/api/internal/maintenance/view-flush",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/publishing?mode=work",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/publishing?mode=reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/internal/delivery/reconcile?scope=provisioning",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/internal/delivery/reconcile?scope=invalidation",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/maintenance/cert-renewal",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/internal/maintenance/facebook-prewarm",
      "schedule": "17 * * * *"
    }
  ]
}