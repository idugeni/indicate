# Neon Managed Better Auth (active provider in this migration branch)
# Copy the exact URL from the Neon Console for the target branch.
NEON_AUTH_BASE_URL=https://your-neon-auth-host/indicate/auth
# Generate with: openssl rand -base64 32. Keep server-side only.
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Primary Neon PostgreSQL connections for the application.
# Pooled URL should use the Neon pooler hostname; direct URL is for migrations/tooling.
DATABASE_POOL_URL=postgresql://user:replace-password@ep-example-pooler.c-4.ap-southeast-1.aws.neon.tech/indicate?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:replace-password@ep-example.c-4.ap-southeast-1.aws.neon.tech/indicate?sslmode=require
