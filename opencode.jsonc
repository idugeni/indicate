{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "watcher": {
    "ignore": ["supabase/.temp/**"]
  },
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=cmqipmerhfpfqoeasibs&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
      },
      "codebase-memory": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "codebase-memory-mcp"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp"
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      },
      "next-devtools": {
        // Menunjuk devDependency lokal, bukan `npx @latest`. `npx` memaksa
        // registry lookup + contended lock di npm _npx cache tiap spawn, dan
        // OpenCode start ~10 MCP server npx bersamaan; spawn yang kalah lock
        // mati seketika dan dilaporkan "Connection closed".
        "type": "local",
        "command": [
          "node",
          "node_modules/next-devtools-mcp/dist/index.js"
        ]
      },
      "webmcp": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@jason.today/webmcp@latest",
          "--mcp"
        ]
      },
      "resend": {
        "type": "remote",
        "url": "https://mcp.resend.com/mcp"
      },
      "upstash-redis": {
        // Kredensial TIDAK ditulis di sini. dotenvx memuat .env project
        // (git-ignored) saat spawn dengan cwd = workspace. {env:...} tidak
        // dipakai karena hanya membaca process environment OpenCode,
        // bukan file .env.
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@dotenvx/dotenvx",
          "run",
          "--",
          "npx",
          "-y",
          "@upstash/redis-mcp"
        ]
      },
      "semgrep": {
        // Python sistem 3.14 tidak didukung semgrep; uvx pin interpreter
        // 3.13 terisolasi agar install ini tidak menyentuh environment utama.
        // Package dipin ke 1.178.0: 1.179.0 tidak mempublikasi win_amd64 wheel
        // di PyPI sehingga Windows fallback ke sdist tanpa semgrep-core.exe
        // dan exit 2 sebelum handshake MCP. Naikkan pin setelah upstream
        // mempublikasi ulang wheel Windows.
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "uvx",
          "--python",
          "3.13",
          "semgrep@1.178.0",
          "mcp"
        ]
      },
      "gsc": {
        // Search Console MCP. Credential TIDAK ditulis di sini. Nilai
        // GSC_OAUTH_CLIENT_SECRETS_FILE adalah path absolut ke file OAuth
        // client Google, jadi hanya berlaku di satu mesin; ia dibaca dari
        // process environment. Kontrak nilainya ada di .env.example. OAuth
        // flow menyimpan token sendiri di direktori config platform OpenCode,
        // bukan di workspace.
        //
        // `uvx` dipin ke interpreter 3.13 untuk alasan yang sama seperti
        // semgrep di atas: Python sistem 3.14 tidak ada di jalur dukungan
        // server ini, dan pin ini membuat install tidak menyentuh environment
        // utama. Package-nya mempin `mcp[cli]<2.0.0` sejak 0.3.3 karena SDK
        // 2.0 menghapus modul `mcp.server.fastmcp`.
        //
        // GSC_ALLOW_DESTRUCTIVE sengaja tidak di-set. Tanpa itu `add_site`,
        // `delete_site`, dan `delete_sitemap` mati, dan MCP ini tidak bisa
        // menulis apa pun ke Search Console maupun ke Postgres. Script
        // `npm run gsc:apply` tetap satu-satunya jalur yang boleh
        // mendaftarkan property dan submit sitemap, karena itu menulis DNS TXT
        // lewat Cloudflare.
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "uvx",
          "--python",
          "3.13",
          "mcp-search-console"
        ]
      }
    }
  }
}
