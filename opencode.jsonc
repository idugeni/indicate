{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "watcher": {
    "ignore": ["supabase/.temp/**"]
  },
  "mcp": {
    "servers": {
      "browser-use": {
        "type": "remote",
        "url": "https://api.browser-use.com/v3/mcp",
        "oauth": false,
        "headers": {
          "x-browser-use-api-key": "{env:BROWSER_USE_API_KEY}"
        }
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=cmqipmerhfpfqoeasibs&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
      },
      "codegraph": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "codegraph",
          "serve",
          "--mcp"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp"
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      },
      "next-devtools": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "next-devtools-mcp@latest"
        ]
      },
      "webmcp": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@jason.today/webmcp@latest",
          "--mcp"
        ]
      },
      "resend": {
        "type": "remote",
        "url": "https://mcp.resend.com/mcp"
      },
      "statsig": {
        "type": "remote",
        "url": "https://api.statsig.com/v1/mcp"
      },
      "telegram": {
        // Token TIDAK ditulis di sini. @iqai/mcp-telegram membawa dotenvx:
        // saat spawn dengan cwd = workspace, ia memuat TELEGRAM_BOT_TOKEN
        // dari .env project ini (git-ignored). Jangan set token di sini —
        // string kosong dari substitusi env justru menutupi fallback .env.
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@iqai/mcp-telegram"
        ],
        "environment": {
          "SAMPLING_ENABLED": "false"
        }
      },
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp",
        "headers": {
          "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
        }
      }
    }
  }
}
