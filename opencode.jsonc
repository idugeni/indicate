{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "watcher": {
    "ignore": ["supabase/.temp/**"]
  },
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=cmqipmerhfpfqoeasibs&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
      },
      "codegraph": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "codegraph",
          "serve",
          "--mcp"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp"
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      },
      "next-devtools": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "next-devtools-mcp@latest"
        ]
      },
      "webmcp": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@jason.today/webmcp@latest",
          "--mcp"
        ]
      },
      "resend": {
        "type": "remote",
        "url": "https://mcp.resend.com/mcp"
      },
      "upstash-redis": {
        // Kredensial TIDAK ditulis di sini. dotenvx memuat .env project
        // (git-ignored) saat spawn dengan cwd = workspace. {env:...} tidak
        // dipakai karena hanya membaca process environment OpenCode,
        // bukan file .env.
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@dotenvx/dotenvx",
          "run",
          "--",
          "npx",
          "-y",
          "@upstash/redis-mcp"
        ]
      },
      "semgrep": {
        // Python sistem 3.14 tidak didukung semgrep; uvx pin interpreter
        // 3.13 terisolasi agar install ini tidak menyentuh environment utama.
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "uvx",
          "--python",
          "3.13",
          "semgrep",
          "mcp"
        ]
      }
    }
  }
}
