{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "watcher": {
    "ignore": ["supabase/.temp/**"]
  },
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=cmqipmerhfpfqoeasibs&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
      },
      "codegraph": {
        // Dipanggil lewat bundle resmi, bukan `cmd /c codegraph`. Rantai shim
        // lama (cmd -> .cmd nvm4w -> npm-shim.js -> bundle Node 24) sempat
        // membuat OpenCode menutup transport dengan "Connection closed" tanpa
        // baris log dan tanpa proses tersisa, padahal `codegraph serve --mcp`
        // sehat saat dijalankan manual. Menunjuk `node.exe` + `codegraph.js`
        // langsung memotong dua hop pertama. Path ini mengikuti lokasi
        // install global Node; sinkronkan ulang bila `npm root -g` berubah.
        "type": "local",
        "command": [
          "C:/nvm4w/nodejs/node_modules/@colbymchenry/codegraph/node_modules/@colbymchenry/codegraph-win32-x64/node.exe",
          "--liftoff-only",
          "--disable-warning=ExperimentalWarning",
          "C:/nvm4w/nodejs/node_modules/@colbymchenry/codegraph/node_modules/@colbymchenry/codegraph-win32-x64/lib/dist/bin/codegraph.js",
          "serve",
          "--mcp"
        ],
        "enabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp"
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      },
      "next-devtools": {
        // Menunjuk devDependency lokal, bukan `npx @latest`. `npx` memaksa
        // registry lookup + contended lock di npm _npx cache tiap spawn, dan
        // OpenCode start ~10 MCP server npx bersamaan; spawn yang kalah lock
        // mati seketika dan dilaporkan "Connection closed".
        "type": "local",
        "command": [
          "node",
          "node_modules/next-devtools-mcp/dist/index.js"
        ]
      },
      "webmcp": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@jason.today/webmcp@latest",
          "--mcp"
        ]
      },
      "resend": {
        "type": "remote",
        "url": "https://mcp.resend.com/mcp"
      },
      "upstash-redis": {
        // Kredensial TIDAK ditulis di sini. dotenvx memuat .env project
        // (git-ignored) saat spawn dengan cwd = workspace. {env:...} tidak
        // dipakai karena hanya membaca process environment OpenCode,
        // bukan file .env.
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@dotenvx/dotenvx",
          "run",
          "--",
          "npx",
          "-y",
          "@upstash/redis-mcp"
        ]
      },
      "semgrep": {
        // Python sistem 3.14 tidak didukung semgrep; uvx pin interpreter
        // 3.13 terisolasi agar install ini tidak menyentuh environment utama.
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "uvx",
          "--python",
          "3.13",
          "semgrep",
          "mcp"
        ]
      }
    }
  }
}
