{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "watcher": {
    "ignore": ["supabase/.temp/**"]
  },
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=cisnmzzmvenbgwetaztl&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
      },
      "codegraph": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "codegraph",
          "serve",
          "--mcp"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp"
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp?codemode=search_and_execute"
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      },
      "next-devtools": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "next-devtools-mcp@latest"
        ]
      },
      "webmcp": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@jason.today/webmcp@latest",
          "--mcp"
        ]
      }
    }
  }
}
