{
  "name": "indicate",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Indicate adalah platform penerbitan jaringan media multi-tenant terpusat: satu ruang redaksi untuk mengelola ratusan portal berita di banyak domain, region, dan subdomain. Redaksi menulis satu artikel lalu menerbitkannya ke banyak publisher dan wilayah sekaligus, masing-masing dengan domain, konfigurasi, SEO, varian konten, dan status publikasi sendiri. Dilengkapi penerbitan antrean terisolasi per-target (retry, unpublish, bulk), resolusi hostname berbasis database, isolasi cache dan SEO per-host, dashboard multi-organisasi dengan RBAC, integrasi Telegram dan API key, serta jejak audit hanya-tambah.",
  "author": {
    "name": "PT SANCA PHENA CAKRA",
    "email": "sancaphenacakra@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/idugeni/indicate.git"
  },
  "bugs": {
    "url": "https://github.com/idugeni/indicate/issues",
    "email": "sancaphenacakra@gmail.com"
  },
  "homepage": "https://github.com/idugeni/indicate#readme",
  "keywords": [
    "cms",
    "multi-tenant",
    "publishing",
    "publishing-platform",
    "news-portal",
    "multi-region",
    "nextjs",
    "postgresql",
    "drizzle-orm",
    "supabase"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:md": "npx -y markdownlint-cli2 \"*.md\" \"docs/**/*.md\" \".github/**/*.md\" \"workers/**/*.md\" \"src/**/*.md\" \"public/**/*.md\"",
    "lint:md:citations": "node scripts/qa/doc-citations.mjs",
    "lint:docs": "npm run lint:md && npm run lint:md:citations",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "perf:listing-payload": "node scripts/perf/listing-payload.mjs",
    "perf:seal-coldstart": "node scripts/perf/seal-coldstart.mjs",
    "perf": "npm run perf:listing-payload && npm run perf:seal-coldstart",
    "db:bootstrap": "node scripts/db-bootstrap.mjs",
    "db:bootstrap:check": "node scripts/db-bootstrap.mjs --check",
    "hygiene:publishers": "node scripts/db-publisher-hygiene.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
