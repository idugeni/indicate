+}
+
+/* Canvas tenant mengikuti shell yang ter-render.
+   Sengaja TANPA @layer: `body` memakai `bg-bg` (layer utilities) yang mengalahkan
+   apa pun di layer base, jadi aturan per-template di base tidak pernah berlaku
+   dan kanvas jatuh ke warna kontrol yang gelap. Aturan tanpa layer menang atas
+   semua layer. `html` ikut dicat supaya area yang belum dilukis `body` (mis. saat
+   bilah browser seluler menutup dan viewport membesar) tidak jatuh ke putih.
+   Tanpa DB dan tanpa JS, murni :has progresif. */
+html:has([data-template='clean-blue']),
+body:has([data-template='clean-blue']) { background-color: #f5f8fd; }
+html:has([data-template='black-lime']),
+body:has([data-template='black-lime']) { background-color: #0a0c07; }
+html:has([data-template='dark-navy']),
+body:has([data-template='dark-navy']) { background-color: #070f22; }
+html:has([data-template='glassy-blue']),
+body:has([data-template='glassy-blue']) { background-color: #edf4ff; }
+html:has([data-template='green-minimal']),
+body:has([data-template='green-minimal']) { background-color: #f7faf7; }
+html:has([data-template='orange-modern']),
+body:has([data-template='orange-modern']) { background-color: #fff9f4; }
+html:has([data-template='purple-editorial']),
+body:has([data-template='purple-editorial']) { background-color: #f8f7ff; }
+html:has([data-template='red-editorial']),
+body:has([data-template='red-editorial']) { background-color: #fffafa; }
+html:has([data-template='soft-blue']),
+body:has([data-template='soft-blue']) { background-color: #f1f6ff; }
+html:has([data-template='warm-editorial']),
+body:has([data-template='warm-editorial']) { background-color: #fdf7f0; }
