{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=cmqipmerhfpfqoeasibs&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
    },
    "codebase-memory": {
      "command": "npx",
      "args": [
        "-y",
        "codebase-memory-mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--headless",
        "--isolated",
        "--no-performance-crux",
        "--no-usage-statistics",
        "--screenshotFormat=jpeg",
        "--screenshotMaxWidth=1280"
      ],
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=6144",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1",
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "next-devtools": {
      "command": "node",
      "args": [
        "node_modules/next-devtools-mcp/dist/index.js"
      ]
    },
    "webmcp": {
      "command": "npx",
      "args": [
        "-y",
        "@jason.today/webmcp@latest",
        "--mcp"
      ]
    },
    "resend": {
      "type": "http",
      "url": "https://mcp.resend.com/mcp"
    },
    "upstash-redis": {
      "command": "npx",
      "args": [
        "-y",
        "@dotenvx/dotenvx",
        "run",
        "--",
        "npx",
        "-y",
        "@upstash/redis-mcp"
      ]
    },
    "semgrep": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "semgrep@1.178.0",
        "mcp"
      ]
    },
    "gsc": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "mcp-search-console"
      ]
    }
  }
}
