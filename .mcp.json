{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=cmqipmerhfpfqoeasibs&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
    },
    "codegraph": {
      "type": "stdio",
      "command": "C:/nvm4w/nodejs/node_modules/@colbymchenry/codegraph/node_modules/@colbymchenry/codegraph-win32-x64/node.exe",
      "args": [
        "--liftoff-only",
        "--disable-warning=ExperimentalWarning",
        "C:/nvm4w/nodejs/node_modules/@colbymchenry/codegraph/node_modules/@colbymchenry/codegraph-win32-x64/lib/dist/bin/codegraph.js",
        "serve",
        "--mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "next-devtools": {
      "command": "node",
      "args": [
        "node_modules/next-devtools-mcp/dist/index.js"
      ]
    },
    "webmcp": {
      "command": "npx",
      "args": [
        "-y",
        "@jason.today/webmcp@latest",
        "--mcp"
      ]
    },
    "resend": {
      "type": "http",
      "url": "https://mcp.resend.com/mcp"
    },
    "upstash-redis": {
      "command": "npx",
      "args": [
        "-y",
        "@dotenvx/dotenvx",
        "run",
        "--",
        "npx",
        "-y",
        "@upstash/redis-mcp"
      ]
    },
    "semgrep": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "semgrep",
        "mcp"
      ]
    },
    "gsc": {
      "command": "uvx",
      "args": [
        "--python",
        "3.13",
        "mcp-search-console"
      ]
    }
  }
}
