{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/modules/*": [
        "./src/modules/*"
      ],
      "@/data/*": [
        "./src/data/*"
      ],
      "@/core/*": [
        "./src/core/*"
      ],
      "@/integrations/*": [
        "./src/integrations/*"
      ],
      "@/ui/*": [
        "./src/ui/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tmp",
    "_tmp-*",
    // The dev server writes its own route validators under `.next/dev/types`
    // with hashed route keys that no longer match the built routes, so leaving
    // them in the program fails `npm run build` on image metadata routes that
    // the build validator does not check at all. `.next/types` stays included,
    // so build-time route typing is unaffected.
    ".next/dev"
  ]
}
